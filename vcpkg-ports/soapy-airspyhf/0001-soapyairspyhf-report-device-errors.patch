 {
-    SoapySDR_logf(SOAPY_SDR_DEBUG, "Setting sample rate: %d", sampleRate);
+    const uint32_t newRate = (uint32_t) rate;
+    SoapySDR_logf(SOAPY_SDR_DEBUG, "Setting sample rate: %d", newRate);
 
-    if (sampleRate != rate) {
-        sampleRate = rate;
+    std::lock_guard <std::mutex> lock(_general_state_mutex);
