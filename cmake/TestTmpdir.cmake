#
# A temp folder of its own for every test, in the build tree.
#
# dsd_neo_add_test_tmpdirs(), called last in each directory that registers
# tests, gives each of them ${PROJECT_BINARY_DIR}/test-tmp/<TEST> through
# TMPDIR, TEMP, TMP and DSD_NEO_TEST_TMPDIR (the C helpers, Python's tempfile,
# Qt, pwsh and the JVM runner each read one of them), and records its name and
# directory. GIT_CEILING_DIRECTORIES stops at test-tmp: the build tree is often
# inside the checkout, and git run in a test's scratch repository must not find
# the checkout's own repository above it.
#
# dsd_neo_write_test_tmpdir_prepare(), called once after every directory's
# tests are registered, writes CTestCustom.cmake into the build tree's top and
# into each directory that registered tests, since ctest reads the one where it
# starts (ctest --test-dir build/<preset>/tests reads the tests/ one): before its
# first test, every ctest run in this build tree removes test-tmp and makes one
# empty folder per recorded test (tests/cmake/TestTmpdirPrepare.cmake). One
# ctest run at a time per build tree, then, as the tests' other outputs there
# already need.
#
# Nothing here checks the folders: tools/check_test_tmp_leftovers.sh, run after
# ctest (CI and tools/preflight_ci.sh), fails naming each test whose folder is
# not empty, and deletes nothing.

function(dsd_neo_add_test_tmpdirs)
    get_property(_tests DIRECTORY PROPERTY TESTS)
    set(_root "${PROJECT_BINARY_DIR}/test-tmp")
    cmake_path(NATIVE_PATH _root _ceiling)
    foreach(_test IN LISTS _tests)
        set(_dir "${_root}/${_test}")
        # The value goes to the test as it is, with no shell to undo escapes:
        # cmake_path() gives the native separators and nothing else.
        cmake_path(NATIVE_PATH _dir _native)
        set_property(
            TEST ${_test}
            APPEND
            PROPERTY
                ENVIRONMENT
                    "TMPDIR=${_native}"
                    "TEMP=${_native}"
                    "TMP=${_native}"
                    "DSD_NEO_TEST_TMPDIR=${_native}"
                    "GIT_CEILING_DIRECTORIES=${_ceiling}"
        )
        set_property(GLOBAL APPEND PROPERTY DSD_NEO_TEST_TMPDIR_NAMES ${_test})
    endforeach()
    if(_tests)
        set_property(
            GLOBAL
            APPEND
            PROPERTY DSD_NEO_TEST_TMPDIR_DIRS "${CMAKE_CURRENT_BINARY_DIR}"
        )
    endif()
endfunction()

# Write @p content to @p path when it differs, as file(CONFIGURE) would, but
# with no @VAR@ substitution: a path in it may hold an '@'.
function(_dsd_neo_write_if_changed path content)
    if(EXISTS "${path}")
        file(READ "${path}" _old)
        if(_old STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${content}")
endfunction()

function(dsd_neo_write_test_tmpdir_prepare)
    get_property(_names GLOBAL PROPERTY DSD_NEO_TEST_TMPDIR_NAMES)
    get_property(_dirs GLOBAL PROPERTY DSD_NEO_TEST_TMPDIR_DIRS)
    list(JOIN _names "\n" _text)
    set(_root "${PROJECT_BINARY_DIR}/test-tmp")
    set(_list "${PROJECT_BINARY_DIR}/test-tmp.names")
    set(_script "${PROJECT_SOURCE_DIR}/tests/cmake/TestTmpdirPrepare.cmake")
    _dsd_neo_write_if_changed("${_list}" "${_text}\n")
    # ctest splits the command at spaces outside double quotes and at ';', and
    # reads a '"' (and, off Windows, a '\\') inside one as quoting: a path
    # holding one would reach the script cut short, and the script removes ROOT.
    # Configuring such a build tree with tests fails here instead.
    set(_unsafe "[\";]")
    if(NOT WIN32)
        set(_unsafe "[\";\\]")
    endif()
    foreach(
        _path
        IN
        ITEMS "${CMAKE_COMMAND}" "${_root}" "${_list}" "${_script}"
    )
        if(_path MATCHES "${_unsafe}" OR _path MATCHES "]==]")
            message(
                FATAL_ERROR
                "The tests' temp folders need paths without '\"', ';' or '\\' (ctest's pre-test command cannot carry them): ${_path}. Configure with another build directory, or with BUILD_TESTING=OFF."
            )
        endif()
    endforeach()
    # A bracket argument holds the command as literal text: ctest reads this
    # file as CMake code, where a '$' in a path would otherwise mean something.
    # Each path is in double quotes for ctest's own word splitting.
    set(_command
        "\"${CMAKE_COMMAND}\" \"-DROOT=${_root}\" \"-DNAMES=${_list}\" -P \"${_script}\""
    )
    set(_content
        "# Generated by cmake/TestTmpdir.cmake: every ctest run starts with empty per-test temp folders.\nset(CTEST_CUSTOM_PRE_TEST [==[${_command}]==])\n"
    )
    # And every directory between them and the top: ctest --test-dir
    # build/<preset>/apps reaches apps/dsd-cli's tests through apps/.
    set(_with_parents "")
    foreach(_dir IN LISTS _dirs)
        while(NOT _dir STREQUAL PROJECT_BINARY_DIR)
            list(APPEND _with_parents "${_dir}")
            cmake_path(GET _dir PARENT_PATH _parent)
            if(_parent STREQUAL _dir)
                break()
            endif()
            set(_dir "${_parent}")
        endwhile()
    endforeach()
    list(REMOVE_DUPLICATES _with_parents)
    foreach(_dir IN ITEMS "${PROJECT_BINARY_DIR}" LISTS _with_parents)
        _dsd_neo_write_if_changed("${_dir}/CTestCustom.cmake" "${_content}")
    endforeach()
endfunction()
