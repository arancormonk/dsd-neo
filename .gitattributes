# Vendored upstream snapshots: carried verbatim so they stay diffable against the
# release they came from. Marking them keeps them out of language statistics and
# collapsed in review, and matches the tooling exclusions in .clang-format-ignore,
# tools/format.sh and .githooks/pre-push.
src/third_party/** linguist-vendored
android/third_party/libusb/** linguist-vendored
android/third_party/librtlsdr/** linguist-vendored
android/third_party/libairspy/** linguist-vendored

# Binary I/Q fixtures (cu8): never line-ending converted or diffed as text. Git's
# own detection can take a capture that happens to hold no NUL byte for text.
tests/fixtures/iq/*.iq binary
