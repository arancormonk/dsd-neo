      <return>
        <item><siteId>1</siteId><lat>41.65503</lat><lon>-91.60244</lon><range>20</range></item>
        <item><siteId>2</siteId><lat xsi:nil="true"/><lon>-91.60244</lon><range>20</range></item>
      </return>
    </getTrsSitesResponse>
  </SOAP-ENV:Body>
</SOAP-ENV:Envelope>
