+/*!
+ * Open a device from an already-open USB file descriptor.
+ *
+ * Device discovery is disabled for the process, so no enumeration is performed and
+ * no /dev/bus/usb access is required. Intended for Android, where the application
+ * obtains the descriptor from UsbDeviceConnection.getFileDescriptor(). The caller
+ * keeps ownership of \p sys_fd and must keep it open for the lifetime of the device.
+ *
+ * \param dev output, device handle
+ * \param sys_fd an open USB file descriptor
+ * \return 0 on success
+ */
+RTLSDR_API int rtlsdr_open_fd(rtlsdr_dev_t **dev, int sys_fd);
+
