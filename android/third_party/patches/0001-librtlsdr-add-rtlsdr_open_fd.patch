+/* Open a device from a file descriptor that was obtained elsewhere — on Android an
+ * app cannot open /dev/bus/usb nodes itself, so Java hands over an already-open fd
+ * from UsbDeviceConnection.getFileDescriptor(). Device discovery has to be disabled
+ * before the context exists, which is why the enumeration path cannot be reused. */
+int rtlsdr_open_fd(rtlsdr_dev_t **out_dev, int sys_fd)
+{
+#if defined(LIBUSB_API_VERSION) && (LIBUSB_API_VERSION >= 0x01000108)
+	int r;
+	rtlsdr_dev_t *dev = NULL;
+
+	if (!out_dev || sys_fd < 0)
+		return -1;
+
+	dev = malloc(sizeof(rtlsdr_dev_t));
+	if (NULL == dev)
+		return -ENOMEM;
+
+	memset(dev, 0, sizeof(rtlsdr_dev_t));
+	memcpy(dev->fir, fir_default, sizeof(fir_default));
+
+	/* NULL context on purpose: the option has to be set before libusb_init(). */
+	r = libusb_set_option(NULL, LIBUSB_OPTION_NO_DEVICE_DISCOVERY);
+	if (r < 0) {
+		fprintf(stderr, "libusb_set_option error %d\n", r);
+		free(dev);
+		return -1;
+	}
+
+	r = libusb_init(&dev->ctx);
+	if (r < 0) {
+		free(dev);
+		return -1;
+	}
+
+	dev->dev_lost = 1;
+
+	r = libusb_wrap_sys_device(dev->ctx, (intptr_t)sys_fd, &dev->devh);
+	if (r < 0) {
+		fprintf(stderr, "libusb_wrap_sys_device error %d\n", r);
+		goto err;
+	}
+
+	r = rtlsdr_init_opened_device(dev);
+	if (r < 0)
+		goto err;
+
+	*out_dev = dev;
+
+	return 0;
+err:
+	if (dev) {
+		if (dev->devh)
+			libusb_close(dev->devh);
+
+		if (dev->ctx)
+			libusb_exit(dev->ctx);
+
+		free(dev);
+	}
+
+	return r;
+#else
+	(void)out_dev;
+	(void)sys_fd;
+	fprintf(stderr, "rtlsdr_open_fd needs libusb >= 1.0.24\n");
+	return -1;
+#endif
+}
