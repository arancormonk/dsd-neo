<resources>
    <string name="app_name">DSD-neo</string>
    <string name="channel_name">Decoder</string>
    <string name="action_stop">Stop</string>
    <string name="decoder_starting">Starting…</string>
    <string name="decoder_running">Decoding</string>
    <string name="decoder_stopping">Stopping…</string>
    <string name="decoder_listening">Listening</string>
    <!-- Quoted because aapt2 strips leading and trailing whitespace from a string
         resource: written bare, this compiles to "·" and the notification body runs
         together as "Encrypted·Unit 1234". The quotes are the delimiter, not content. -->
    <string name="notif_separator">" · "</string>
    <string name="notif_unit">Unit %1$s</string>
    <string name="notif_encrypted">Encrypted</string>
    <string name="notif_alg">ALG %1$s</string>
    <string name="notif_kid">KID %1$s</string>
    <string name="notif_control_freq">Control %1$s</string>
    <string name="notif_freq_mhz">%.06f MHz</string>
    <string name="notif_slot">Slot %1$d</string>
    <!-- Issue #773: a private call headlines its other party; a call no party named, its protocol. -->
    <string name="notif_private">Private</string>
    <string name="notif_radio_id">ID %1$s</string>
    <string name="notif_private_call">Private call</string>
    <string name="notif_protocol_call">%1$s call</string>
    <string name="notif_identity_not_decoded">Identity not decoded</string>
    <!-- Shown in the app when a start dies before the engine ever runs. The code is
         carried through because the underlying reason only exists in logcat. -->
    <string name="error_init_failed">The decoder could not be initialised (code %1$d).</string>
    <string name="error_configure_failed">Those options were rejected (code %1$d). Check the input settings.</string>
    <string name="error_busy">A previous session is still stopping</string>
    <!-- #782: a start that could not take its USB receiver. The app's card words these by kind; this is the record's text. -->
    <string name="error_usb_gone">The USB receiver is no longer connected</string>
    <string name="error_usb_permission">The USB receiver needs permission again</string>
    <string name="error_usb_open_failed">The USB receiver could not be reopened</string>
    <string name="decoder_emergency_prefix">EMERGENCY ·&#32;</string>
    <!-- #782: TalkBack turned on while the app runs. The app's screens can be read only when TalkBack was on as the
         app opened, and the app never closes itself, so this says how to reopen it and what closing costs. It names
         the place, not a gesture: under TalkBack a Recents card closes with TalkBack's own gestures or actions. -->
    <string name="a11y_restart_title">Reopen DSD-neo to use TalkBack</string>
    <string name="a11y_restart_message">TalkBack can read DSD-neo only if TalkBack was on when the app opened. Close DSD-neo from Recent apps, then open it again. Closing stops decoding.</string>
</resources>
