<!-- minSdk is 29, so this always wins over the mipmap-*dpi bitmaps; those exist
     only so aapt badging and store tooling still find a plain icon.
     <monochrome> feeds Android 13+ themed icons and is ignored below API 33. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/dsdneo_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
