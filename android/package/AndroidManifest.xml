<?xml version="1.0"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">

    <!-- Foreground only; approximate access remains usable for site selection. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Qt Network's network-information plugin, which the APK packages. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- #830: Android 10 reads device storage in the file browser through the legacy view
         (requestLegacyExternalStorage below, inert from Android 11 on), read-only: nothing here
         asks for write access, which the same grant would otherwise carry. Android 11 and later
         reach shared storage only with All files access, which only the side-loaded APK asks for
         (sideload/AndroidManifest.xml). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- required="false" on purpose: rtl_tcp, UDP and file inputs all work without
         USB host support, so a phone that lacks OTG should still be able to install. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- #829: with no OPEN_DOCUMENT picker, DocumentPicker lists the GET_CONTENT apps to offer, which package
         visibility hides without this. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!-- Every permission is declared above rather than inserted by androiddeployqt: Qt
         Core's rules would add WRITE_EXTERNAL_STORAGE. -->
    <!-- %%INSERT_FEATURES -->

    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true" />

    <!-- allowBackup is off deliberately: a full-data backup binds a backup agent into
         this process and tears it down again, which killed a 28-minute decode session on
         device. The app's own encrypted backup (Settings → Backup, issue #580) moves a
         setup to another phone instead, and runs only when the user asks for it. -->
    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="-- %%INSERT_APP_NAME%% --"
        android:icon="-- %%INSERT_APP_ICON%% --"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DsdNeo"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupOnly="false"
        android:requestLegacyExternalStorage="true">

        <!-- QtActivity plus one override: it raises the Qt quit that Qt's own teardown
             waits for but does not send. See DsdNeoActivity. -->
        <!-- One instance per process (#782): Qt 6.11.3 restarts the whole process, skipping
             the app's teardown, when a second instance is created in a process it already
             started. singleTask brings the running instance forward (to onNewIntent) for all
             four outside launches: a USB attachment, a document another app opens with or
             shares to DSD-neo (#831), the launcher icon and the decoding notification, where
             singleTop could create a new one on top of a picker or permission dialog. The
             cost: each of the four closes a picker or permission dialog open in the app's
             task, which then returns cancelled; the flows treat that as a cancel. configChanges
             lists every configuration change the platform defines
             (android-36, so compileSdk 36), assetsPaths (a runtime overlay turned on) included,
             so none recreates the activity. resourcesUnused is left out on purpose: it is
             for activities that use no resources, and this one uses the splash, the strings
             and the notice dialog. The list is explicit rather than aapt2's allKnown so that
             launch_policy in tests/android/run_jvm_tests.py can pin it. A recreation that
             still happens is recorded by LaunchGuard. -->
        <!-- The launcher activity has to be exported: it carries the MAIN/LAUNCHER and
             USB_DEVICE_ATTACHED filters, delivered by the system from outside the app, and the
             Open with (VIEW) and Share (SEND) filters, delivered from other apps (#831). The
             app-specific inputs are two: a USB attachment, validated by deviceName and VID/PID
             against UsbManager.deviceList and deduplicated until detach, and an incoming
             document, which IncomingDocumentIntake takes only as one content URI that is not
             the app's own and that the app holds a read grant for. Extras that cannot be read
             are dropped before Qt reads them (IntentExtras). No intent extra supplies decoder
             options or bypasses the opt-in UI policy. Suppressed on this element and this
             rule only, rather than excluding the manifest from the scan. The finding predates
             DsdNeoActivity — it fires on the stock QtActivity declaration too — and only
             surfaces when a change touches this file. -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name="io.github.arancormonk.dsdneo.DsdNeoActivity"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|colorMode|grammaticalGender|fontScale|fontWeightAdjustment|assetsPaths"
            android:label="-- %%INSERT_APP_NAME%% --"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Plugging a listed dongle in launches the app and grants it permission
                 for that device, which is the only way to skip the prompt. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />

            <!-- Open with (#831): a backup or a CSV file another app opens with DSD-neo. Content
                 URIs only; text/plain is here for senders that label a CSV as text. No */*. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Share (#831): one file shared to DSD-neo, in EXTRA_STREAM. No scheme, since a
                 filter that lists one does not match an intent with no data, which a SEND is;
                 no text/plain, which would offer DSD-neo for every shared link or text; no
                 SEND_MULTIPLE. IncomingDocumentIntake checks the stream itself. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Qt's own launch screen. API 29-30 predate the platform
                 SplashScreen API, and on 31+ this bridges the gap between the
                 system splash and Qt Quick's first frame. -->
            <meta-data
                android:name="android.app.splash_screen_drawable"
                android:resource="@drawable/splash" />

            <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />

            <meta-data
                android:name="android.app.arguments"
                android:value="-- %%INSERT_APP_ARGUMENTS%% --" />
        </activity>

        <!-- Same process as the activity: the Qt UI reads app-control snapshots in-process. -->
        <service
            android:name="io.github.arancormonk.dsdneo.DecoderService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qtprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/qtprovider_paths"/>
        </provider>
        <!-- WP-F5: separate narrow provider, leaving Qt's paths unchanged. -->
        <provider
            android:name="io.github.arancormonk.dsdneo.DiagnosticsProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_paths"/>
        </provider>
        <!-- #708: call recordings, shared one at a time and read-only; only the "Call recordings" folders of the
             two recording roots are reachable through it. -->
        <provider
            android:name="io.github.arancormonk.dsdneo.RecordingsProvider"
            android:authorities="${applicationId}.recordings"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/recordings_paths"/>
        </provider>
    </application>
</manifest>
