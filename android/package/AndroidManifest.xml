<?xml version="1.0"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">

    <!-- Foreground only; approximate access remains usable for site selection. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- required="false" on purpose: rtl_tcp, UDP and file inputs all work without
         USB host support, so a phone that lacks OTG should still be able to install. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- %%INSERT_PERMISSIONS -->
    <!-- %%INSERT_FEATURES -->

    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true" />

    <!-- allowBackup is off deliberately: a full-data backup binds a backup agent into
         this process and tears it down again, which killed a 28-minute decode session on
         device. The app's own encrypted backup (Settings → Backup, issue #580) moves a
         setup to another phone instead, and runs only when the user asks for it. -->
    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="-- %%INSERT_APP_NAME%% --"
        android:icon="-- %%INSERT_APP_ICON%% --"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DsdNeo"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupOnly="false">

        <!-- QtActivity plus one override: it raises the Qt quit that Qt's own teardown
             waits for but does not send. See DsdNeoActivity. -->
        <!-- One instance per process (#782): Qt 6.11.2 restarts the whole process, skipping
             the app's teardown, when a second instance is created in a process it already
             started. singleTask brings the running instance forward for a USB attachment
             (to onNewIntent), the launcher icon and the decoding notification, where
             singleTop could create a new one on top of a picker or permission dialog. The
             cost: those three close a picker or permission dialog open in the app's task,
             which then returns cancelled; the flows treat that as a cancel. configChanges
             lists every configuration change the platform defines
             (android-36, so compileSdk 36), assetsPaths (a runtime overlay turned on) included,
             so none recreates the activity. resourcesUnused is left out on purpose: it is
             for activities that use no resources, and this one uses the splash, the strings
             and the notice dialog. The list is explicit rather than aapt2's allKnown so that
             launch_policy in tests/android/run_jvm_tests.py can pin it. A recreation that
             still happens is recorded by LaunchGuard. -->
        <!-- The launcher activity has to be exported: it carries the MAIN/LAUNCHER filter
             and the USB_DEVICE_ATTACHED filter, and both are delivered by the system from
             outside the app. The only app-specific input is a USB attachment, validated by deviceName
             and VID/PID against UsbManager.deviceList and deduplicated until detach.
             No intent extra supplies decoder options or bypasses the opt-in UI policy. Suppressed on
             this element and this rule only, rather than excluding the manifest from the
             scan. The finding predates DsdNeoActivity — it fires on the stock QtActivity
             declaration too — and only surfaces when a change touches this file. -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name="io.github.arancormonk.dsdneo.DsdNeoActivity"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|colorMode|grammaticalGender|fontScale|fontWeightAdjustment|assetsPaths"
            android:label="-- %%INSERT_APP_NAME%% --"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Plugging a listed dongle in launches the app and grants it permission
                 for that device, which is the only way to skip the prompt. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />

            <!-- Qt's own launch screen. API 29-30 predate the platform
                 SplashScreen API, and on 31+ this bridges the gap between the
                 system splash and Qt Quick's first frame. -->
            <meta-data
                android:name="android.app.splash_screen_drawable"
                android:resource="@drawable/splash" />

            <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />

            <meta-data
                android:name="android.app.arguments"
                android:value="-- %%INSERT_APP_ARGUMENTS%% --" />
        </activity>

        <!-- Same process as the activity: the Qt UI reads app-control snapshots in-process. -->
        <service
            android:name="io.github.arancormonk.dsdneo.DecoderService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qtprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/qtprovider_paths"/>
        </provider>
        <!-- WP-F5: separate narrow provider, leaving Qt's paths unchanged. -->
        <provider
            android:name="io.github.arancormonk.dsdneo.DiagnosticsProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_paths"/>
        </provider>
        <!-- #708: call recordings, shared one at a time and read-only; only the "Call recordings" folders of the
             two recording roots are reachable through it. -->
        <provider
            android:name="io.github.arancormonk.dsdneo.RecordingsProvider"
            android:authorities="${applicationId}.recordings"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/recordings_paths"/>
        </provider>
    </application>
</manifest>
