# Build artifacts
/build/
/vcpkg_installed/

# Tool caches
/.cache/
/.ccache/
/.ci/
/.deps/
/.deps-arch-toolchain/

# Visual Studio
/.vs/

# Editor/IntelliSense database generated via CMake Tools
/compile_commands.json

# OS files
.DS_Store
Thumbs.db

# Ignore all markdown files in root directory with exceptions
/*.md
!/README.md
!/SECURITY.md
!/CONTRIBUTING.md
!/THIRD_PARTY.md
!/PRIVACY_POLICY.md

# GDB files
*.gdb

# Log files
/logs/
*.log
*.out
/captures/
/Testing/
# Local ETSI EN 300 395-2 speech sources. Never commit these.
/tools/tetra/etsi/
/tools/tetra/acelp_adapter/C-CODE/

# Scratch content under tmp is ignored; the two tracked ETSI reference files
# remain versioned because ignore rules do not affect tracked files.
/tmp/*
/.cmake-format.local.out
/.gitleaks.sarif
/.osv-scanner.local.out
/.osv-scanner.sarif
/.zizmor.local.out
/.zizmor.sarif
/.zizmor-pedantic.sarif
/.strict-analysis/
/.strict-checkpoints/
/.preflight-baseline*/
/.scan-build.local/
/.cppcheck-build/
# Regression and trace artifacts
artifacts/
/.iq-fixture-cache/
__pycache__/
